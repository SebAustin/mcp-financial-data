# Copy to .env and fill in. Never commit .env.
# All keys are read by src/mcp_financial_data/settings.py via pydantic-settings.

# --- Anthropic ---------------------------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_PRIMARY=claude-sonnet-4-6
ANTHROPIC_MODEL_JUDGE=claude-opus-4-7

# --- Hard spend cap (USD per project, enforced in extractor + harness) -------
MAX_API_SPEND_USD=50

# --- SEC EDGAR (Fair Access requires a contact User-Agent) -------------------
# Format: "Your Name or Org <contact@example.com>". SEC requests a real human-
# reachable contact; without one the SEC may block requests from your IP.
EDGAR_USER_AGENT=
EDGAR_RATE_LIMIT_PER_SEC=10

# --- FRED (St. Louis Fed) ----------------------------------------------------
FRED_API_KEY=

# --- Polygon.io --------------------------------------------------------------
POLYGON_API_KEY=

# --- MCP OAuth 2.1 resource server ------------------------------------------
# These describe THIS server as an OAuth 2.1 resource server (per MCP spec
# 2025-11-25). The issuer is your IdP (Auth0, Authentik, or local kc).
MCP_OAUTH_ISSUER=https://idp.local.test
MCP_OAUTH_AUDIENCE=mcp-financial-data
MCP_OAUTH_JWKS_URL=https://idp.local.test/.well-known/jwks.json
MCP_OAUTH_REQUIRED_SCOPES=mcp:read mcp:tools
# Optional: shared secret for HS256 dev tokens (issue_dev_token + matching validator).
# Refused at runtime unless MCP_OAUTH_ISSUER is a local dev URL. NEVER ship a real value.
MCP_OAUTH_DEV_SECRET=
MCP_OAUTH_JWKS_TTL_SECONDS=3600

# --- Server bind -------------------------------------------------------------
MCP_HOST=127.0.0.1
MCP_PORT=8765

# --- Eval harness ------------------------------------------------------------
EVAL_OFFLINE=1            # 1 = use fixtures only; 0 = real network
EVAL_RUNS_DIR=evals/runs
EVAL_SEED=20260518

# --- Postgres (eval response cache; docker-compose service name) ------------
POSTGRES_DSN=postgresql://mcp:mcp@localhost:5432/mcp_financial_data

# --- Logging ------------------------------------------------------------------
LOG_LEVEL=INFO
LOG_FORMAT=json
